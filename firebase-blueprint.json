{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents an employee/user in the canteen system.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "employmentType": { 
          "type": "string",
          "enum": ["White collar staff", "Blue collar staff", "Delog", "Tuskeegee", "Medical"] 
        },
        "department": { 
          "type": "string",
          "enum": ["HR", "Engineering", "Finance", "Production", "Pre Press", "Logistics", "Quality", "SHER"] 
        },
        "rfidCardId": { "type": "string", "description": "RFID or NFC card serial number / badge ID" },
        "rfidCardAssignedAt": { "type": "string", "format": "date-time" },
        "ticketsBalance": { "type": "integer" },
        "weeklyAllocation": { "type": "integer" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "adminLevel": { "type": "integer", "description": "1 for Maker, 2 for Checker" },
        "status": { "type": "string", "enum": ["pending_approval", "active", "pending_deletion"] },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "department", "role"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Record of a meal ticket being used.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "department": { "type": "string" },
        "employmentType": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "mealType": { "type": "string" },
        "authMethod": { "type": "string", "enum": ["rfid", "manual"] },
        "cardId": { "type": "string" }
      },
      "required": ["userId", "timestamp", "department"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Root collection for users."
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Collection for recording meal usage."
    }
  }
}
