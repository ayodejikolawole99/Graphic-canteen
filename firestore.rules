rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (getUserData().role == 'admin' || request.auth.token.email == 'ayodejikolawole99@gmail.com');
    }

    function getAdminLevel() {
      return getUserData().get('adminLevel', 1);
    }

    function isChecker() {
      return isAdmin() && (getAdminLevel() == 2 || request.auth.token.email == 'ayodejikolawole99@gmail.com');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['id', 'name', 'department', 'role', 'ticketsBalance', 'weeklyAllocation', 'status']) &&
               data.id is string &&
               data.name is string && data.name.size() <= 100 &&
               data.department is string && data.department.size() <= 50 &&
               data.role in ['user', 'admin'] &&
               data.status in ['pending_approval', 'active', 'pending_deletion'] &&
               data.ticketsBalance is int &&
               data.weeklyAllocation is int &&
               isValidId(data.id);
      }

      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidUser(request.resource.data) && request.resource.data.status == 'pending_approval';
      allow update: if (isAdmin() && (
                          // Rule for Checkers: Can change anything or approve
                          (isChecker()) ||
                          // Rule for Makers: Can request deletion or change token
                          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'biometricToken']) && 
                           request.resource.data.status in ['pending_deletion', 'pending_approval'])
                        )) && isValidUser(request.resource.data);
      allow delete: if isChecker();
    }

    match /attendance/{attendanceId} {
      function isValidAttendance(data) {
        return data.keys().hasAll(['userId', 'userName', 'department', 'timestamp', 'mealType']) &&
               data.userId == request.auth.uid &&
               data.timestamp == request.time &&
               data.department is string &&
               data.department.size() <= 50 &&
               isValidId(data.userId);
      }

      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidAttendance(request.resource.data) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ticketsBalance > 0;
    }
  }
}
