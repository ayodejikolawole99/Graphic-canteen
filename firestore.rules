rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ayodejikolawole99@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin')
      );
    }

    function getAdminLevel() {
      return (request.auth.token.email == 'ayodejikolawole99@gmail.com') ? 2 :
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('adminLevel', 1) : 1);
    }

    function isChecker() {
      return (request.auth.token.email == 'ayodejikolawole99@gmail.com') ||
             (isAdmin() && getAdminLevel() == 2);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['id', 'name', 'department', 'role', 'ticketsBalance', 'weeklyAllocation', 'status']) &&
               data.id is string &&
               data.name is string && data.name.size() <= 100 &&
               data.department is string && data.department.size() <= 60 &&
               data.role in ['user', 'admin'] &&
               data.status in ['active', 'pending_approval', 'pending_deletion'] &&
               data.ticketsBalance is int &&
               data.weeklyAllocation is int &&
               isValidId(data.id);
      }

      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && (userId == request.auth.uid || isAdmin() || request.auth.token.email == 'ayodejikolawole99@gmail.com');
      allow update: if isSignedIn() && (
        (isAdmin() && (
          (isChecker()) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'biometricToken', 'ticketsBalance', 'weeklyAllocation']))
        )) ||
        (isOwner(userId) && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ticketsBalance', 'biometricToken', 'webauthnCredentialId', 'webauthnPublicKey'])
        )
      );
      allow delete: if isChecker();
    }

    match /attendance/{attendanceId} {
      function isValidAttendance(data) {
        return data.keys().hasAll(['userId', 'userName', 'department', 'timestamp', 'mealType']) &&
               data.userId is string &&
               data.timestamp == request.time &&
               data.department is string &&
               data.department.size() <= 60 &&
               isValidId(data.userId);
      }

      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidAttendance(request.resource.data) &&
                      (request.resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
